# =============================================================================
# SmartRoom Manager — variables d'environnement.
#
#   cp .env.example .env
#
# Ce fichier est versionné ; `.env` ne l'est pas. Aucune valeur d'ici n'est un
# secret : celles qui en sont marquées « à remplacer » font échouer le
# démarrage tant qu'elles n'ont pas été changées, hors environnement local.
#
# La validation a lieu au démarrage, dans `app/core/config.py`. Une variable
# manquante arrête le conteneur avec un message explicite plutôt que de laisser
# l'application tomber à la première requête, en production, devant un
# utilisateur.
# =============================================================================

# --- Environnement -----------------------------------------------------------
# `local` assouplit les contrôles : secrets d'usine tolérés, cookie sans HTTPS,
# journaux en texte. Toute autre valeur — `production`, `recette` — les impose.
ENVIRONMENT=local

TIMEZONE=Europe/Paris

# --- Base de données ---------------------------------------------------------
POSTGRES_DB=smartroom
POSTGRES_USER=smartroom
# À REMPLACER hors local : « smartroom » et « postgres » sont refusés.
POSTGRES_PASSWORD=smartroom
# Port exposé sur l'hôte en développement seulement. La pile de production
# n'expose pas la base.
POSTGRES_PORT=5432

# --- Sessions et jetons ------------------------------------------------------
# À REMPLACER hors local. Trente-deux caractères au moins ; le démarrage
# refuse la valeur d'usine et les secrets trop courts.
#   openssl rand -base64 48
JWT_SECRET=changez-moi-en-production

# Quinze minutes : une fuite de jeton d'accès expire vite, et le
# rafraîchissement rend cette brièveté indolore.
ACCESS_TTL_MINUTES=15
# Trente jours : le jeton de rafraîchissement vit en cookie httpOnly, hors de
# portée du JavaScript, sa durée peut donc être longue.
REFRESH_TTL_DAYS=30
# Faux en local uniquement : sans HTTPS, un cookie `Secure` ne serait jamais
# transmis et la session ne tiendrait pas. Le démarrage l'impose hors local.
REFRESH_COOKIE_SECURE=false

# --- Limitation de débit -----------------------------------------------------
# Rend le bourrage d'identifiants impraticable sans gêner un humain.
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_RESET=3/hour

# --- CORS --------------------------------------------------------------------
# Liste explicite au format JSON. Le joker est refusé par les navigateurs dès
# lors que les requêtes portent des cookies, ce qui est le cas ici.
# En production : l'origine publique, et elle seule.
CORS_ORIGINS=["http://localhost:5180","http://127.0.0.1:5180"]

# --- Courriel ----------------------------------------------------------------
# Faux en local : les courriels sont écrits dans le journal plutôt qu'envoyés,
# et aucune boîte réelle ne reçoit les données du jeu de démonstration.
MAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
MAIL_FROM=no-reply@smartroom.ece.fr

# --- Tâches planifiées -------------------------------------------------------
# Période de la maintenance : libération des créneaux non validés, clôture des
# réservations écoulées, rafraîchissement des agrégats.
MAINTENANCE_INTERVAL_SECONDS=300
# Fenêtre du rappel envoyé avant le début d'un créneau.
REMINDER_LEAD_MINUTES=30

# --- Agrégats ----------------------------------------------------------------
# Cinq minutes : au-delà, un administrateur verrait des chiffres périmés ; en
# deçà, la vue matérialisée serait relue pour rien.
STATS_CACHE_SECONDS=300

# --- Fichiers téléversés -----------------------------------------------------
# Plans d'étage et photos de salles. En production, un volume monté : sans
# cela, un redéploiement effacerait les plans déposés par l'administration.
MEDIA_ROOT=media
MEDIA_URL=/media

# --- Journalisation ----------------------------------------------------------
# JSON en production — un journal s'interroge ; texte en local — un journal se
# lit. Ni jeton ni mot de passe n'y figurent jamais.
LOG_LEVEL=INFO
LOG_JSON=true

# =============================================================================
# Production uniquement — le compose refuse de démarrer sans ces valeurs.
# =============================================================================

# Domaine public, celui que sert le proxy et pour lequel il obtient un
# certificat. Front et API le partagent : une origine unique permet au cookie
# de rester `SameSite=lax`.
PUBLIC_DOMAIN=smartroom.example.fr

# Adresse à laquelle Let's Encrypt signale un certificat proche de l'expiration.
ACME_EMAIL=admin@example.fr

# Domaine redirigé vers le domaine canonique, si un second existe. Laisser la
# valeur par défaut le neutralise.
REDIRECT_FROM=invalid.local

# Étiquette des images construites. Le laisser à `latest` empêche de revenir en
# arrière : préférez une version ou l'empreinte du commit.
VERSION=latest

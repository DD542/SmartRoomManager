# Copier en .env — ce fichier n'est jamais commité.
ENVIRONMENT=local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smartroom
POSTGRES_USER=smartroom
POSTGRES_PASSWORD=smartroom
TIMEZONE=Europe/Paris

# Signature des jetons. Obligatoire dès que ENVIRONMENT n'est pas « local ».
JWT_SECRET=changez-moi-en-production
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=30

# Cookie du jeton de rafraîchissement. `Secure` exige HTTPS : le laisser à true
# en local empêcherait le navigateur de transmettre le cookie.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# Réinitialisation de mot de passe et limitation de débit.
RESET_TTL_MINUTES=30
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_RESET=3/hour

# Courriel. Désactivé en local : les messages partent dans le journal.
MAIL_ENABLED=false
MAIL_FROM=no-reply@smartroom.ece.fr
SMTP_HOST=localhost
SMTP_PORT=1025

# Durée de validité des agrégats de tableau de bord, en secondes.
STATS_CACHE_SECONDS=300

# Période de la tâche de libération automatique, en secondes.
MAINTENANCE_INTERVAL_SECONDS=300

# Origines autorisées par CORS, au format JSON.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Répertoire des fichiers téléversés — plans d'étage, photos de salles. En
# production, un volume monté : sans cela, un redéploiement effacerait les
# plans déposés par l'administration.
MEDIA_ROOT=media
# Préfixe public correspondant, monté en statique par l'application.
MEDIA_URL=/media

# ------------------------------------------------------------------ Google
#
# Connexion et création de compte par Google. Vide, le bouton ne s'affiche pas
# du tout — un bouton présent qui échoue à chaque clic fait croire à une panne
# là où il n'y a qu'une option non activée.
#
# L'identifiant se crée sur https://console.cloud.google.com/apis/credentials
# (« ID client OAuth » de type « Application Web »). Il est public : il figure
# dans la page de tout site qui propose cette connexion. Le secret associé
# n'est pas utilisé ici — le navigateur rend un jeton d'identité, que le
# serveur vérifie contre les clés publiques de Google.
GOOGLE_CLIENT_ID=

# Domaines autorisés à ouvrir un compte, séparés par des virgules. Vide, tout
# compte Google est accepté. « ece.fr,edu.ece.fr » fermerait l'application à la
# seule école.
GOOGLE_ALLOWED_DOMAINS=

# Domaines de l'etablissement, separes par des virgules. Un compte dont
# l'adresse n'en releve pas porte l'etiquette « Hors organisation » dans
# l'annuaire de l'administration : il a le droit d'etre la, mais on doit
# pouvoir le distinguer sans relire chaque adresse. Vide, personne n'est
# signale : mieux vaut ne rien dire que marquer tout le monde.
ORGANISATION_DOMAINS=ece.fr,edu.ece.fr

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55441
POSTGRES_USER=smartroom
POSTGRES_PASSWORD=smartroom
POSTGRES_DB=smartroom
JWT_SECRET=""
CORS_ORIGINS=["http://localhost:5180","http://127.0.0.1:5180"]

# ---------------------------------------------------------------- courriel
#
# Deux configurations, une seule active à la fois.
#
# A. Boîte de développement — celle en place. `docker compose up -d courriel`,
#    puis http://localhost:8025. Tout est intercepté, rien ne quitte la
#    machine, quelle que soit l'adresse écrite sur le message.
#MAIL_ENABLED=true
#SMTP_HOST=127.0.0.1
#SMTP_PORT=1025
#SMTP_USE_TLS=false
#MAIL_FROM=no-reply@smartroom.ece.fr
#
# B. Envoi réel — commentez le bloc A, décommentez celui-ci et complétez.
#    Les identifiants se saisissent ici, à la main : ils n'ont à passer par
#    personne d'autre, et ce fichier est ignoré par git.
#
#    Gmail exige un « mot de passe d'application » : la validation en deux
#    étapes doit être active sur le compte, puis le mot de passe se crée sur
#    https://myaccount.google.com/apppasswords — seize caractères, à recopier
#    sans les espaces. Le mot de passe habituel du compte est refusé.
#
#    MAIL_FROM doit être l'adresse du compte authentifié : Gmail refuse
#    d'expédier au nom d'une adresse qu'il ne possède pas, et une adresse
#    inventée fait finir le message en indésirable quand elle ne le fait pas
#    rejeter.
#
#    Port 587 (STARTTLS) ou 465 (TLS d'emblée) : les deux fonctionnent.
#
MAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""

# ------------------------------------------------------------------ Google
#
# Connexion et création de compte par un compte Google. L'identifiant est
# public : il figure dans la page de tout site qui propose cette connexion.
# Le code secret du client n'est pas utilisé — le navigateur rend un jeton
# d'identité, que le serveur vérifie contre les clés publiques de Google.
#
# Vide, le bouton ne s'affiche pas du tout.50156026642
GOOGLE_CLIENT_ID=""

# Domaines autorisés, séparés par des virgules. Vide, tout compte Google est
# accepté ; « ece.fr,edu.ece.fr » fermerait l'application à la seule école.
GOOGLE_ALLOWED_DOMAINS=


# ------------------------------------------------------- assistant, etage B
#
# Optionnel, et vide par defaut. Toute API compatible OpenAI convient ; ces
# lignes decrivent la configuration verifiee : Gemini par sa facade OpenAI.
#
# Il existe parce qu'aucun hebergement gratuit ne fait tourner un modele de
# sept milliards de parametres. Sans lui, l'assistant en ligne repond par son
# moteur deterministe et la recherche documentaire perd son volet vectoriel.
#
#IA_DISTANT_URL=https://generativelanguage.googleapis.com/v1beta/openai
#IA_DISTANT_CLE=
#IA_DISTANT_MODELE_VECTEURS=gemini-embedding-001
#
# Le raisonnement reste facultatif. Renseigne, il rend a l'assistant en
# ligne ce que le moteur deterministe ne sait pas faire : comprendre une
# question hors de ses cinq intentions declarees, et decider lui-meme
# d'interroger la base de connaissances. Vide, l'etage B ne sert qu'aux
# vecteurs. En local, Ollama passe avant : ces lignes ne changent rien.
#
#IA_DISTANT_MODELE_RAISONNEMENT=gemini-2.5-flash
#IA_DISTANT_MODELE_RAPIDE=gemini-2.5-flash-lite
#
# Reserve le role « vecteurs » a l'etage B, meme quand Ollama repond.
#
# Les fragments stockes portent les coordonnees que leur a donnees un modele
# donne. Poste local et hebergement partageant la meme base, sans ce reglage
# l'un vectorise avec Ollama et l'autre avec l'etage B : la similarite reste
# calculable et compare deux espaces sans rapport. Vrai des deux cotes, il
# rend le corpus coherent.
#
# Changer de modele impose `python -m scripts.reindexer_connaissances`.
#IA_VECTEURS_TOUJOURS_DISTANTS=true

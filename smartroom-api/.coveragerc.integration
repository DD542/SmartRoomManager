[run]
branch = True
source =
    app/services
    app/api
omit =
    app/api/v1/schemas/*

[report]
show_missing = True
skip_covered = False
fail_under = 85
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    raise NotImplementedError
    # Corps de stub réduit à une ellipse, et lui seul. Le motif était ancré
    # nulle part : « tuple[TimeSlot, ...] » y répondait, ce qui excluait la
    # signature et tout le corps de vingt-quatre fonctions du domaine — 185
    # instructions sorties de la mesure sans que le total cesse d'afficher
    # 100 %. Un seuil qui ne mesure plus ne protège plus.
    ^\s*\.\.\.$

[html]
directory = htmlcov/integration
